+# ----------------------------------------------------------------------------
+# Native function-calling (tool-call) action mode: the agent's action is the
+# `code` argument of a single execute_python tool call instead of free text.
+# Enabled with ACON_APPWORLD_ACTION_MODE=toolcall; the default is unchanged.
+# ----------------------------------------------------------------------------
+def _appworld_tool_description() -> str:
+    """Tool description shown to the agent every step (function-calling mode).
+
+    ACON_APPWORLD_TOOLDESC_NEUTRAL selects the wording:
+      unset / "0" : full description, ends "Call apis.supervisor.complete_task(answer=...) when done."
+      "1"         : same text with that sentence replaced by a restatement of the prompt's completion rule
+      "none"      : same text without any completion sentence
+      "minimal"   : interface only; AppWorld's own prompt carries every instruction
+      "empty"     : no description at all (the tool is declared with its name and parameters only)
+    """
+    mode = os.environ.get("ACON_APPWORLD_TOOLDESC_NEUTRAL", "0")
+    if mode == "minimal":
+        return "Execute Python code in the AppWorld REPL. Returns the printed output."
+    base = ("Execute Python code in the AppWorld REPL. The code may call AppWorld "
+            "APIs as apis.<app>.<endpoint>(...). Explore with "
+            "apis.api_docs.show_api_descriptions(app_name=...) and "
+            "apis.api_docs.show_api_doc(app_name=..., api_name=...). ")
+    if mode == "none":
+        tail = ""
+    elif mode == "1":
+        tail = ("Call apis.supervisor.complete_task() when done; pass answer= only if the task "
+                "asks for information. ")
+    else:
+        tail = "Call apis.supervisor.complete_task(answer=...) when done. "
+    return base + tail + "Returns the printed output."
+
+
+def _appworld_tool_spec() -> dict:
+    if os.environ.get("ACON_APPWORLD_TOOLDESC_NEUTRAL") == "empty":
+        return {"type": "function", "function": {
+            "name": "execute_python",
+            "parameters": {"type": "object", "properties": {"code": {"type": "string"}}, "required": ["code"]},
+        }}
+    return {"type": "function", "function": {
+        "name": "execute_python",
+        "description": _appworld_tool_description(),
+        "parameters": {
+            "type": "object",
+            "properties": {"code": {"type": "string", "description": "Python code to run"}},
+            "required": ["code"],
+        },
+    }}
+
+
+APPWORLD_EXECUTE_PYTHON_TOOL = [_appworld_tool_spec()]
+
+TOOLCALL_SYSTEM_SUFFIX = (
+    "\n\nEmit every action by calling the execute_python tool with a single "
+    "'code' string argument. Put all reasoning in your thinking; never write "
+    "code or prose outside the tool call."
+)
+
+# Match <think> and namespaced variants such as <mm:think>.
+_THINK_BLOCK_RE = re.compile(r"<\s*(?:[\w.-]+:)?think[^>]*>.*?<\s*/\s*(?:[\w.-]+:)?think\s*>",
+                             re.DOTALL | re.IGNORECASE)
+_THINK_INNER_RE = re.compile(r"<\s*(?:[\w.-]+:)?think[^>]*>(.*?)<\s*/\s*(?:[\w.-]+:)?think\s*>",
+                             re.DOTALL | re.IGNORECASE)
+
+
+def extract_reasoning(content: str) -> str:
+    """Return the model's full reasoning from a tool-call message `content`:
+    the inner text of <think>...</think> plus any visible preamble after it,
+    with the tags removed. Used to fold the reasoning into the recorded action
+    as inert # comments (thoughts-as-comments) for later history compression.
+    """
+    if not content:
+        return ""
+    inner = "\n".join(m.strip() for m in _THINK_INNER_RE.findall(content) if m.strip())
+    preamble = _strip_think_blocks(content)
+    parts = [p for p in (inner.strip(), preamble.strip()) if p]
+    return "\n\n".join(parts)
+
+
+def appworld_toolcall_enabled() -> bool:
+    """True when the env-gated native function-calling action mode is on."""
+    return os.environ.get("ACON_APPWORLD_ACTION_MODE", "text").strip().lower() == "toolcall"
+
+
+def _strip_think_blocks(text: str) -> str:
+    """Drop <think>...</think> blocks so stored assistant content stays lean."""
+    if not isinstance(text, str):
+        return ""
+    cleaned = _THINK_BLOCK_RE.sub("", text)
+    # Reasoning models sometimes emit a trailing </think> with no opening tag.
+    if re.search(r"<\s*/\s*(?:[\w.-]+:)?think\s*>", cleaned, flags=re.IGNORECASE):
+        cleaned = re.split(r"<\s*/\s*(?:[\w.-]+:)?think\s*>", cleaned, flags=re.IGNORECASE)[-1]
+    cleaned = re.sub(r"<\s*/?\s*(?:[\w.-]+:)?think[^>]*>", "", cleaned, flags=re.IGNORECASE)
+    return cleaned.strip()
+
+
+def _code_parses(code: str) -> bool:
+    try:
+        ast.parse(code or "")
+        return True
+    except SyntaxError:
+        return False
