+    def _initialize_system_message(self):
+        """Initialize system message; append tool-call instruction when enabled."""
+        super()._initialize_system_message()
+        # ACON_APPWORLD_TOOLCALL_SUFFIX=0: add nothing to the system message in tool-call mode;
+        # the model picks up the tool from the declaration alone.
+        if appworld_toolcall_enabled() and os.environ.get("ACON_APPWORLD_TOOLCALL_SUFFIX", "1") != "0":
+            self.system_message = (self.system_message or "") + TOOLCALL_SYSTEM_SUFFIX
+
+    def toolcall_enabled(self) -> bool:
+        """Whether this agent is running in native function-calling mode."""
+        return appworld_toolcall_enabled()
+
+    def forward(self, prompt) -> LLMOutput:
+        """Generate an action.
+
+        In tool-call mode the model is invoked with the execute_python tool and
+        the action is read from message.tool_calls (no prose-as-code parsing).
+        The tool_call_id and serialized tool_calls are returned in metadata so
+        the run loop can record the assistant tool_call and feed the
+        observation back as a tool-role message.
+        """
+        if not self.toolcall_enabled():
+            return super().forward(prompt)
+
+        try:
+            message = self.llm.generate(
+                prompt,
+                tools=APPWORLD_EXECUTE_PYTHON_TOOL,
+                tool_choice="auto",
+                seed=self.seed,
+            )
+        except Exception as e:  # noqa: BLE001
+            self.logger.error(f"Tool-call generation error: {e}")
+            message = None
+
+        tool_calls = getattr(message, "tool_calls", None) if message is not None else None
+        full_content = getattr(message, "content", "") or "" if message is not None else ""
+        raw_content = _strip_think_blocks(full_content)
+        reasoning = extract_reasoning(full_content)
+        # Some servers return the thinking in a separate `reasoning`/`reasoning_content`
+        # field instead of inline <think> tags; fall back to it when inline extraction
+        # is empty so the recorded history keeps the model's reasoning.
+        if not reasoning and message is not None:
+            sep = getattr(message, "reasoning", None) or getattr(message, "reasoning_content", None)
+            if sep:
+                # Strip any think markers embedded in the separate reasoning field.
+                reasoning = _strip_think_blocks(str(sep))
+
+        if tool_calls:
+            tc = tool_calls[0]
+            arguments = tc.function.arguments or ""
+            try:
+                code = json.loads(arguments).get("code", "")
+            except Exception:  # noqa: BLE001
+                code = arguments
+            serialized = [{
+                "id": tc.id,
+                "type": "function",
+                "function": {"name": tc.function.name, "arguments": arguments},
+            }]
+            metadata = {
+                "tool_call_id": tc.id,
+                "tool_calls": serialized,
+                "action_mode": "toolcall",
+                "reasoning": reasoning,
+            }
+            if self.debug_mode:
+                self._debug_print(prompt, f"[tool_call execute_python] {code[:200]}")
+            return LLMOutput(action=code, response=raw_content, metadata=metadata)
+
+        # Fallback: model did not emit a tool_call. Extract code-only and never
+        # execute prose; if it does not parse, return an empty (no-op) action.
+        extracted = self.action_processor.extract_action(raw_content)
+        if not _code_parses(extracted):
+            self.logger.warning(
+                "Tool-call mode: no tool_call and fallback code did not parse; "
+                "emitting empty action to avoid executing prose-as-code."
+            )
+            extracted = ""
+        metadata = {"tool_call_id": None, "tool_calls": None,
+                    "action_mode": "toolcall_fallback", "reasoning": reasoning}
+        return LLMOutput(action=extracted, response=raw_content, metadata=metadata)
+
