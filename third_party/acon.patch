+def _acon_strip_think(text):
+    """Strip <think>...</think> reasoning blocks from a model's text output.
+
+    Enabled with ACON_VLLM_STRIP_THINK=1; the default behaviour is unchanged.
+    Handles fully tagged blocks, a trailing </think> with no opening tag, and
+    leftover bare tags.
+    """
+    if not isinstance(text, str) or os.environ.get("ACON_VLLM_STRIP_THINK") != "1":
+        return text
+    # Match <think>, </think> and namespaced variants such as <mm:think>.
+    cleaned = _re.sub(r"<\s*(?:[\w.-]+:)?think[^>]*>.*?<\s*/\s*(?:[\w.-]+:)?think\s*>", "", text,
+                      flags=_re.DOTALL | _re.IGNORECASE)
+    # Reasoning models sometimes emit "...reasoning... </think> answer"
+    # with no opening tag; keep only the content after the final closing tag.
+    if _re.search(r"<\s*/\s*(?:[\w.-]+:)?think\s*>", cleaned, flags=_re.IGNORECASE):
+        cleaned = _re.split(r"<\s*/\s*(?:[\w.-]+:)?think\s*>", cleaned, flags=_re.IGNORECASE)[-1]
+    # Drop any leftover bare tags.
+    cleaned = _re.sub(r"<\s*/?\s*(?:[\w.-]+:)?think[^>]*>", "", cleaned, flags=_re.IGNORECASE)
+    return cleaned.strip()
 
